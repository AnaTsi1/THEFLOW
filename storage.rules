rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isReasonableUpload() {
      return request.resource != null
        && request.resource.size < 25 * 1024 * 1024;
    }

    match /users/{uid}/profile/{fileName} {
      allow read: if signedIn();
      allow write: if isOwner(uid) && isReasonableUpload()
        && request.resource.contentType.matches('image/.*');
    }

    match /posts/{postId}/media/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && isReasonableUpload()
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
        );
    }

    // Storage rules can't check Firestore studio membership; the real gate is the Firestore
    // studios/{id} update rule the resulting URL is written through (owner/manager only).
    match /studios/{studioId}/profile/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && isReasonableUpload()
        && request.resource.contentType.matches('image/.*');
    }

    // Same pattern: Storage can't check Firestore applicantUid, so the real gate is the
    // Firestore professionalApplications update rule the resulting URL is written through.
    match /professionalApplications/{applicationId}/documents/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && isReasonableUpload()
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
