{
  "name": "the-flow-demo-seed",
  "private": true,
  "version": "1.0.0",
  "description": "Safe demo data seeding tools for THE FLOW Firebase project.",
  "main": "seedDemoData.js",
  "scripts": {
    "dry-run:small": "node seedDemoData.js --size small --dry-run",
    "dry-run:full": "node seedDemoData.js --size full --dry-run",
    "seed:small": "node seedDemoData.js --size small --write",
    "seed:full": "node seedDemoData.js --size full --write",
    "delete:dry-run": "node deleteDemoData.js --dry-run",
    "delete": "node deleteDemoData.js --write"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0"
  }
}
