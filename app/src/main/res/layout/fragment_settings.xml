<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/flow_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp"
        android:paddingLeft="@dimen/flow_screen_padding"
        android:paddingTop="@dimen/flow_gap_medium"
        android:paddingRight="@dimen/flow_screen_padding">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/flow_ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/settings_BTN_back"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_flow_button_secondary"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Back"
            android:textAllCaps="false"
            android:textColor="@color/flow_brand"
            android:textStyle="bold" />

        <Button
            android:id="@+id/settings_BTN_editPreferences"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_flow_button_primary"
            android:text="Edit Feed Preferences"
            android:textColor="@color/flow_surface"
            android:textStyle="bold" />

        <Button
            android:id="@+id/settings_BTN_professionalVerification"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_flow_button_secondary"
            android:text="Professional Verification"
            android:textColor="@color/flow_brand"
            android:textStyle="bold" />

        <Button
            android:id="@+id/settings_BTN_adminReview"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_flow_button_primary"
            android:text="Admin Review"
            android:textColor="@color/flow_surface"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/settings_LAY_notificationSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_flow_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notification Settings"
                android:textColor="@color/flow_ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/settings_SW_allNotifications"
                android:layout_width="match_parent"
                android:layout_height="@dimen/flow_touch_size"
                android:text="Enable notifications"
                android:textColor="@color/flow_text_secondary"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/settings_SW_likes"
                android:layout_width="match_parent"
                android:layout_height="@dimen/flow_touch_size"
                android:text="Likes"
                android:textColor="@color/flow_text_secondary"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/settings_SW_comments"
                android:layout_width="match_parent"
                android:layout_height="@dimen/flow_touch_size"
                android:text="Comments"
                android:textColor="@color/flow_text_secondary"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/settings_SW_newFollowers"
                android:layout_width="match_parent"
                android:layout_height="@dimen/flow_touch_size"
                android:text="New followers"
                android:textColor="@color/flow_text_secondary"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/settings_SW_privateMessages"
                android:layout_width="match_parent"
                android:layout_height="@dimen/flow_touch_size"
                android:text="Private messages"
                android:textColor="@color/flow_text_secondary"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/settings_SW_eventRecommendations"
                android:layout_width="match_parent"
                android:layout_height="@dimen/flow_touch_size"
                android:text="Event recommendations"
                android:textColor="@color/flow_text_secondary"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/settings_SW_registeredEventUpdates"
                android:layout_width="match_parent"
                android:layout_height="@dimen/flow_touch_size"
                android:text="Registered event updates"
                android:textColor="@color/flow_text_secondary"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/settings_SW_professionalApplicationUpdates"
                android:layout_width="match_parent"
                android:layout_height="@dimen/flow_touch_size"
                android:text="Professional application updates"
                android:textColor="@color/flow_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settings_LAY_messageSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_flow_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Message Settings"
                android:textColor="@color/flow_ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/settings_SW_messageNotifications"
                android:layout_width="match_parent"
                android:layout_height="@dimen/flow_touch_size"
                android:text="Message notifications"
                android:textColor="@color/flow_text_secondary"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/settings_SW_messagePreviews"
                android:layout_width="match_parent"
                android:layout_height="@dimen/flow_touch_size"
                android:text="Show message previews"
                android:textColor="@color/flow_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Receive messages from"
                android:textColor="@color/flow_text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/settings_RAD_receiveMessages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/settings_RAD_everyone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/flow_touch_size"
                    android:text="Everyone"
                    android:textColor="@color/flow_text_secondary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/settings_RAD_following"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/flow_touch_size"
                    android:text="People I follow"
                    android:textColor="@color/flow_text_secondary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/settings_RAD_nobody"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/flow_touch_size"
                    android:text="Nobody"
                    android:textColor="@color/flow_text_secondary"
                    android:textSize="13sp" />
            </RadioGroup>

            <Switch
                android:id="@+id/settings_SW_readReceipts"
                android:layout_width="match_parent"
                android:layout_height="@dimen/flow_touch_size"
                android:text="Read receipts"
                android:textColor="@color/flow_text_secondary"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/settings_SW_emojiSuggestions"
                android:layout_width="match_parent"
                android:layout_height="@dimen/flow_touch_size"
                android:text="Emoji suggestions"
                android:textColor="@color/flow_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/settings_LBL_settingsMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/flow_text_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/settings_BTN_logout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_flow_button_secondary"
            android:text="Log out"
            android:textColor="@color/flow_brand"
            android:textStyle="bold" />

        <Button
            android:id="@+id/settings_BTN_deleteAccount"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_flow_button_secondary"
            android:text="@string/settings_delete_account"
            android:textColor="@color/flow_error"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
