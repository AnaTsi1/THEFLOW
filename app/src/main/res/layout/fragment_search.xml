<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/discover_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/discover_screen_padding"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/discover_screen_padding"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/search_LAY_top"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/search_BTN_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_discover_icon_button"
            android:contentDescription="Back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back_24"
            android:tint="@color/discover_ink" />

        <EditText
            android:id="@+id/search_EDT_query"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_discover_input"
            android:hint="Search styles, studios, teachers, events..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/discover_ink"
            android:textColorHint="@color/discover_text_muted" />

        <ImageButton
            android:id="@+id/search_BTN_clear"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_discover_icon_button"
            android:contentDescription="Clear search"
            android:padding="10dp"
            android:src="@drawable/ic_close_24"
            android:tint="@color/discover_text_muted" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/search_SCROLL_categories"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/search_LAY_categories"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/search_LAY_controls"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/search_BTN_filter"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_discover_segment_inactive"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Filters"
            android:textAllCaps="false"
            android:textColor="@color/discover_purple"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/search_CHIP_list"
            android:layout_width="86dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_discover_segment_active"
            android:gravity="center"
            android:text="List"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/search_CHIP_map"
            android:layout_width="86dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_discover_segment_inactive"
            android:gravity="center"
            android:text="Map"
            android:textColor="@color/discover_text_secondary"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/search_LBL_resultSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/discover_text_secondary"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/search_PRG_loading"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:indeterminateTint="@color/discover_purple"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/search_LAY_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/search_SCROLL_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="18dp">

            <LinearLayout
                android:id="@+id/search_LAY_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <FrameLayout
            android:id="@+id/search_LAY_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_discover_map"
            android:padding="2dp"
            android:visibility="gone">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/search_MAP_results"
                android:name="com.google.android.gms.maps.SupportMapFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_gravity="top"
                android:layout_margin="10dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/search_LAY_map_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <Button
                android:id="@+id/search_BTN_search_area"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="64dp"
                android:background="@drawable/bg_discover_segment_active"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Search this area"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/search_BTN_current_location"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_discover_icon_button"
                android:contentDescription="Current location"
                android:padding="10dp"
                android:src="@drawable/ic_my_location_24"
                android:tint="@color/discover_purple" />

            <Button
                android:id="@+id/search_BTN_clear_markers"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_discover_segment_inactive"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Clear Filters"
                android:textAllCaps="false"
                android:textColor="@color/discover_purple"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/search_LAY_marker_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_margin="12dp"
                android:background="@drawable/bg_discover_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/search_LBL_google_attribution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/discover_google_attribution"
        android:textColor="@color/discover_text_muted"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
