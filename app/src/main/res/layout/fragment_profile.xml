<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_SCROLL_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/flow_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingLeft="@dimen/flow_screen_padding"
    android:paddingTop="@dimen/flow_gap_small"
    android:paddingRight="@dimen/flow_screen_padding"
    android:paddingBottom="88dp">

    <LinearLayout
        android:id="@+id/profile_LAY_rootContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="192dp">

            <ImageView
                android:id="@+id/profile_IMG_cover"
                android:layout_width="match_parent"
                android:layout_height="152dp"
                android:background="@drawable/bg_flow_media"
                android:contentDescription="@string/profile_cover_image"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_gravity="top"
                android:layout_marginTop="88dp"
                android:background="@drawable/bg_event_cover_scrim" />

            <FrameLayout
                android:layout_width="114dp"
                android:layout_height="114dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_avatar_ring"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/profile_IMG_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar"
                    android:contentDescription="@string/profile_photo"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/profile_BTN_settings"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:background="@drawable/bg_flow_icon_button"
                android:contentDescription="@string/profile_settings"
                android:padding="10dp"
                android:src="@drawable/ic_settings_24"
                android:tint="@color/flow_brand" />

            <ImageButton
                android:id="@+id/profile_BTN_more"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:background="@drawable/bg_flow_icon_button"
                android:contentDescription="@string/more_options"
                android:padding="10dp"
                android:src="@drawable/ic_more_horizontal_24"
                android:tint="@color/flow_brand"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/profile_LAY_identity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp">

            <TextView
                android:id="@+id/profile_LBL_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textColor="@color/flow_ink"
                android:textSize="26sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/profile_LAY_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/profile_IMG_headlinePin"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_location_24"
                    app:tint="@color/flow_text_secondary" />

                <TextView
                    android:id="@+id/profile_LBL_headline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/flow_text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/profile_LBL_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/flow_ink"
                android:textSize="15sp" />

            <HorizontalScrollView
                android:id="@+id/profile_SCROLL_skillChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/profile_LAY_skillChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/profile_LAY_actionShelf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_flow_card"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:id="@+id/profile_LAY_followStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/profile_BTN_followers"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_flow_button_ghost"
                        android:minWidth="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="18dp"
                        android:textAllCaps="false"
                        android:textColor="@color/flow_ink"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/profile_BTN_following"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_flow_button_ghost"
                        android:minWidth="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="18dp"
                        android:textAllCaps="false"
                        android:textColor="@color/flow_ink"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/profile_BTN_edit"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_flow_button_secondary"
                        android:minWidth="0dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/profile_edit"
                        android:textAllCaps="false"
                        android:textColor="@color/flow_brand"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/profile_LAY_public_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/profile_BTN_follow"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_flow_button_primary"
                        android:minWidth="0dp"
                        android:text="@string/profile_follow"
                        android:textAllCaps="false"
                        android:textColor="@color/flow_surface"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/profile_BTN_message"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_flow_button_secondary"
                        android:contentDescription="@string/profile_message"
                        android:minWidth="0dp"
                        android:text="@string/profile_message"
                        android:textAllCaps="false"
                        android:textColor="@color/flow_brand"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/profile_BTN_report"
                android:layout_width="wrap_content"
                android:layout_height="1dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/profile_BTN_block"
                android:layout_width="wrap_content"
                android:layout_height="1dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profile_LAY_managementActions"
            android:layout_width="wrap_content"
            android:layout_height="1dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/profile_BTN_savedItems"
                android:layout_width="wrap_content"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/profile_BTN_myEvents"
                android:layout_width="wrap_content"
                android:layout_height="1dp" />
        </LinearLayout>

        <Button
            android:id="@+id/profile_BTN_createContent"
            android:layout_width="wrap_content"
            android:layout_height="1dp"
            android:visibility="gone" />

        <View
            android:id="@+id/profile_DIVIDER_media"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:background="@color/flow_border" />

        <LinearLayout
            android:id="@+id/profile_LAY_mediaSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Media"
                    android:textColor="@color/flow_ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/profile_BTN_openMedia"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_flow_button_ghost"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="0dp"
                    android:text="See All"
                    android:textAllCaps="false"
                    android:textColor="@color/flow_brand"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/profile_LAY_mediaStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profile_LAY_tabs"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@color/flow_background"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/profile_TAB_posts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profile_TABLBL_posts"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Posts"
                    android:textColor="@color/flow_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/profile_TABIND_posts"
                    android:layout_width="34dp"
                    android:layout_height="3dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_home_tab_indicator" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/profile_TAB_media"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profile_TABLBL_media"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Media"
                    android:textColor="@color/flow_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/profile_TABIND_media"
                    android:layout_width="34dp"
                    android:layout_height="3dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_home_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/profile_TAB_events"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profile_TABLBL_events"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Events"
                    android:textColor="@color/flow_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/profile_TABIND_events"
                    android:layout_width="34dp"
                    android:layout_height="3dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_home_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/profile_TAB_about"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profile_TABLBL_about"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="About"
                    android:textColor="@color/flow_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/profile_TABIND_about"
                    android:layout_width="34dp"
                    android:layout_height="3dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_home_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/flow_border" />

        <ProgressBar
            android:id="@+id/profile_PROGRESS_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:indeterminateTint="@color/flow_brand"
            android:visibility="gone" />

        <TextView
            android:id="@+id/profile_LBL_postsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_flow_card"
            android:padding="@dimen/flow_card_padding"
            android:text="No posts yet."
            android:textColor="@color/flow_text_muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/profile_LAY_posts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/profile_LAY_mediaPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/profile_LAY_mediaFilters"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/profile_LAY_mediaGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/profile_BTN_closeMedia"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profile_LAY_sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/profile_LAY_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profile_LAY_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_flow_card"
            android:orientation="vertical"
            android:padding="@dimen/flow_card_padding"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Edit Public Profile"
                android:textColor="@color/flow_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/profile_BTN_profilePhoto"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_flow_button_secondary"
                android:text="Choose Profile Photo"
                android:textAllCaps="false"
                android:textColor="@color/flow_brand" />

            <Button
                android:id="@+id/profile_BTN_coverImage"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_flow_button_secondary"
                android:text="Choose Cover Image"
                android:textAllCaps="false"
                android:textColor="@color/flow_brand" />

            <EditText
                android:id="@+id/profile_EDT_bio"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_flow_input"
                android:gravity="top"
                android:hint="Bio"
                android:inputType="textMultiLine"
                android:paddingTop="12dp"
                android:textColor="@color/flow_ink"
                android:textColorHint="@color/flow_text_muted" />

            <EditText
                android:id="@+id/profile_EDT_background"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_flow_input"
                android:gravity="top"
                android:hint="Professional background"
                android:inputType="textMultiLine"
                android:paddingTop="12dp"
                android:textColor="@color/flow_ink"
                android:textColorHint="@color/flow_text_muted" />

            <EditText
                android:id="@+id/profile_EDT_skills"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_flow_input"
                android:hint="Skills / specialties, comma separated"
                android:textColor="@color/flow_ink"
                android:textColorHint="@color/flow_text_muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/profile_BTN_cancelEdit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_flow_button_secondary"
                    android:text="Cancel"
                    android:textAllCaps="false"
                    android:textColor="@color/flow_brand" />

                <Button
                    android:id="@+id/profile_BTN_saveEdit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_flow_button_primary"
                    android:text="Save"
                    android:textAllCaps="false"
                    android:textColor="@color/flow_surface"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profile_LAY_composer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/flow_gap_medium"
            android:background="@drawable/bg_flow_card"
            android:orientation="vertical"
            android:padding="@dimen/flow_card_padding"
            android:visibility="gone">

            <EditText
                android:id="@+id/profile_EDT_postText"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:background="@drawable/bg_flow_input"
                android:gravity="top"
                android:hint="@string/profile_post_hint"
                android:inputType="textMultiLine"
                android:paddingTop="12dp"
                android:textColor="@color/flow_ink"
                android:textColorHint="@color/flow_text_muted" />

            <TextView
                android:id="@+id/profile_LBL_selectedMedia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/flow_gap_small"
                android:textColor="@color/flow_text_muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/flow_gap_medium"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/profile_BTN_postMedia"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/flow_touch_size"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_flow_button_secondary"
                    android:minWidth="0dp"
                    android:text="@string/profile_post_media"
                    android:textAllCaps="false"
                    android:textColor="@color/flow_brand"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/profile_BTN_postActivity"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/flow_touch_size"
                    android:layout_marginHorizontal="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_flow_button_secondary"
                    android:minWidth="0dp"
                    android:text="@string/profile_post_activity"
                    android:textAllCaps="false"
                    android:textColor="@color/flow_brand"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/profile_BTN_postCollaboration"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/flow_touch_size"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_flow_button_secondary"
                    android:minWidth="0dp"
                    android:text="@string/profile_post_collaboration"
                    android:textAllCaps="false"
                    android:textColor="@color/flow_brand"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/profile_LAY_activityFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/flow_gap_medium"
                android:orientation="vertical"
                android:visibility="gone">

                <AutoCompleteTextView
                    android:id="@+id/profile_EDT_activityType"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_flow_input"
                    android:hint="Activity type"
                    android:inputType="none"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />

                <AutoCompleteTextView
                    android:id="@+id/profile_EDT_activityLocation"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/flow_gap_small"
                    android:background="@drawable/bg_flow_input"
                    android:hint="Location"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />

                <EditText
                    android:id="@+id/profile_EDT_activityDate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/flow_gap_small"
                    android:background="@drawable/bg_flow_input"
                    android:hint="Date"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />

                <EditText
                    android:id="@+id/profile_EDT_activityTime"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/flow_gap_small"
                    android:background="@drawable/bg_flow_input"
                    android:hint="Time"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />

                <EditText
                    android:id="@+id/profile_EDT_activityPrice"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/flow_gap_small"
                    android:background="@drawable/bg_flow_input"
                    android:hint="Price"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />

                <EditText
                    android:id="@+id/profile_EDT_activityLevel"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/flow_gap_small"
                    android:background="@drawable/bg_flow_input"
                    android:hint="Level"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />

                <EditText
                    android:id="@+id/profile_EDT_activityDescription"
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    android:layout_marginTop="@dimen/flow_gap_small"
                    android:background="@drawable/bg_flow_input"
                    android:gravity="top"
                    android:hint="Activity description"
                    android:inputType="textMultiLine"
                    android:paddingTop="12dp"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/profile_LAY_collaborationFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/flow_gap_medium"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/profile_EDT_collaborationLookingFor"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_flow_input"
                    android:hint="Looking for"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />

                <EditText
                    android:id="@+id/profile_EDT_collaborationStyle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/flow_gap_small"
                    android:background="@drawable/bg_flow_input"
                    android:hint="Style"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />

                <AutoCompleteTextView
                    android:id="@+id/profile_EDT_collaborationLocation"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/flow_gap_small"
                    android:background="@drawable/bg_flow_input"
                    android:hint="Location"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />

                <EditText
                    android:id="@+id/profile_EDT_collaborationDate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/flow_gap_small"
                    android:background="@drawable/bg_flow_input"
                    android:hint="Date / deadline"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />

                <AutoCompleteTextView
                    android:id="@+id/profile_EDT_collaborationPaid"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/flow_gap_small"
                    android:background="@drawable/bg_flow_input"
                    android:hint="Paid or unpaid"
                    android:inputType="none"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />

                <EditText
                    android:id="@+id/profile_EDT_collaborationDescription"
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    android:layout_marginTop="@dimen/flow_gap_small"
                    android:background="@drawable/bg_flow_input"
                    android:gravity="top"
                    android:hint="Collaboration description"
                    android:inputType="textMultiLine"
                    android:paddingTop="12dp"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />
            </LinearLayout>

            <Button
                android:id="@+id/profile_BTN_createPost"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/flow_touch_size"
                android:layout_marginTop="@dimen/flow_gap_medium"
                android:background="@drawable/bg_flow_button_primary"
                android:minWidth="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/profile_publish"
                android:textAllCaps="false"
                android:textColor="@color/flow_surface"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
