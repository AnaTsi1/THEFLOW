<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/flow_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingLeft="@dimen/flow_screen_padding"
    android:paddingTop="@dimen/flow_gap_medium"
    android:paddingRight="@dimen/flow_screen_padding"
    android:paddingBottom="88dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_flow_card"
            android:orientation="vertical"
            android:padding="@dimen/flow_card_padding">

            <ImageView
                android:id="@+id/profile_IMG_cover"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:background="@drawable/bg_flow_media"
                android:contentDescription="@string/profile_cover_image"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/profile_IMG_avatar"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginTop="-44dp"
                android:background="@drawable/bg_avatar"
                android:contentDescription="@string/profile_photo"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/profile_LBL_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:textColor="@color/flow_ink"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/profile_BTN_settings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_flow_icon_button"
                    android:contentDescription="@string/profile_settings"
                    android:padding="10dp"
                    android:src="@drawable/ic_settings_24"
                    android:tint="@color/flow_brand" />

                <ImageButton
                    android:id="@+id/profile_BTN_more"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_flow_icon_button"
                    android:contentDescription="@string/more_options"
                    android:padding="10dp"
                    android:src="@drawable/ic_more_horizontal_24"
                    android:tint="@color/flow_brand"
                    android:visibility="gone" />
            </LinearLayout>

            <Button
                android:id="@+id/profile_BTN_edit"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/flow_touch_size"
                android:layout_marginTop="@dimen/flow_gap_small"
                android:background="@drawable/bg_flow_button_secondary"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/profile_edit"
                android:textAllCaps="false"
                android:textColor="@color/flow_brand"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/profile_LAY_public_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/flow_gap_small"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/profile_BTN_follow"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/flow_touch_size"
                    android:layout_marginEnd="@dimen/flow_gap_small"
                    android:layout_weight="1"
                    android:background="@drawable/bg_flow_button_primary"
                    android:minWidth="0dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/profile_follow"
                    android:textAllCaps="false"
                    android:textColor="@color/flow_surface"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/profile_BTN_message"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/flow_touch_size"
                    android:layout_weight="1"
                    android:background="@drawable/bg_flow_button_secondary"
                    android:contentDescription="@string/profile_message"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/profile_message"
                    android:textAllCaps="false"
                    android:textColor="@color/flow_brand"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/profile_BTN_report"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/flow_touch_size"
                android:layout_marginTop="@dimen/flow_gap_small"
                android:background="@drawable/bg_flow_button_ghost"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/profile_report"
                android:textAllCaps="false"
                android:textColor="@color/flow_text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/profile_BTN_block"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/flow_touch_size"
                android:layout_marginTop="@dimen/flow_gap_small"
                android:background="@drawable/bg_flow_button_ghost"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/profile_block"
                android:textAllCaps="false"
                android:textColor="@color/flow_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/profile_LBL_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/flow_text_secondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/profile_LBL_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/flow_text_secondary"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/profile_LAY_followStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/profile_BTN_followers"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/flow_touch_size"
                    android:layout_weight="1"
                    android:background="@drawable/bg_flow_button_secondary"
                    android:textColor="@color/flow_brand"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/profile_BTN_following"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/flow_touch_size"
                    android:layout_marginStart="@dimen/flow_gap_small"
                    android:layout_weight="1"
                    android:background="@drawable/bg_flow_button_secondary"
                    android:textColor="@color/flow_brand"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textAllCaps="false" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/profile_LAY_managementActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/flow_gap_medium"
            android:orientation="horizontal">

            <Button
                android:id="@+id/profile_BTN_savedItems"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/flow_touch_size"
                android:background="@drawable/bg_flow_button_secondary"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/profile_saved"
                android:textAllCaps="false"
                android:textColor="@color/flow_brand"
                android:textStyle="bold" />

            <Button
                android:id="@+id/profile_BTN_myEvents"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/flow_touch_size"
                android:layout_marginStart="@dimen/flow_gap_small"
                android:background="@drawable/bg_flow_button_secondary"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/my_events_title"
                android:textAllCaps="false"
                android:textColor="@color/flow_brand"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/profile_BTN_createContent"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/flow_touch_size"
            android:layout_marginTop="@dimen/flow_gap_small"
            android:background="@drawable/bg_flow_button_primary"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Create"
            android:textAllCaps="false"
            android:textColor="@color/flow_surface"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/profile_LAY_sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Professional Details"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/profile_LBL_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/profile_LBL_skills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profile_LAY_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Edit Public Profile"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/profile_LBL_editPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Add only what you want people to see on your public profile."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/profile_BTN_profilePhoto"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Choose Profile Photo"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/profile_BTN_coverImage"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Choose Cover Image"
                android:textColor="@color/text_primary" />

            <EditText
                android:id="@+id/profile_EDT_bio"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input"
                android:gravity="top"
                android:hint="Bio"
                android:inputType="textMultiLine"
                android:paddingTop="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted" />

            <EditText
                android:id="@+id/profile_EDT_background"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:gravity="top"
                android:hint="Professional background"
                android:inputType="textMultiLine"
                android:paddingTop="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted" />

            <EditText
                android:id="@+id/profile_EDT_skills"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:hint="Skills / specialties, comma separated"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/profile_BTN_cancelEdit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary"
                    android:text="Cancel"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/profile_BTN_saveEdit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_primary"
                    android:text="Save"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profile_LAY_mediaSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Media"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/profile_BTN_openMedia"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_button_secondary"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="View all"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/profile_LAY_mediaStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/profile_LAY_mediaPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="All Media"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/profile_BTN_closeMedia"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_button_secondary"
                        android:minWidth="0dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Close"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/profile_LAY_mediaGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profile_LAY_composer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/flow_gap_medium"
            android:background="@drawable/bg_flow_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_create_post"
                android:textColor="@color/flow_ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/profile_EDT_postText"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:layout_marginTop="@dimen/flow_gap_medium"
                android:background="@drawable/bg_flow_input"
                android:gravity="top"
                android:hint="@string/profile_post_hint"
                android:inputType="textMultiLine"
                android:paddingTop="12dp"
                android:textColor="@color/flow_ink"
                android:textColorHint="@color/flow_text_muted" />

            <TextView
                android:id="@+id/profile_LBL_selectedMedia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/flow_gap_small"
                android:textColor="@color/flow_text_muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/flow_gap_medium"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/profile_BTN_postMedia"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/flow_touch_size"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_flow_button_secondary"
                    android:minWidth="0dp"
                    android:text="@string/profile_post_media"
                    android:textAllCaps="false"
                    android:textColor="@color/flow_brand"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/profile_BTN_postActivity"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/flow_touch_size"
                    android:layout_marginHorizontal="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_flow_button_secondary"
                    android:minWidth="0dp"
                    android:text="@string/profile_post_activity"
                    android:textAllCaps="false"
                    android:textColor="@color/flow_brand"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/profile_BTN_postCollaboration"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/flow_touch_size"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_flow_button_secondary"
                    android:minWidth="0dp"
                    android:text="@string/profile_post_collaboration"
                    android:textAllCaps="false"
                    android:textColor="@color/flow_brand"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/profile_LAY_activityFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/flow_gap_medium"
                android:orientation="vertical"
                android:visibility="gone">

                <AutoCompleteTextView
                    android:id="@+id/profile_EDT_activityType"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_flow_input"
                    android:hint="Activity type"
                    android:inputType="none"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />

                <AutoCompleteTextView
                    android:id="@+id/profile_EDT_activityLocation"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/flow_gap_small"
                    android:background="@drawable/bg_flow_input"
                    android:hint="Location"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />

                <EditText
                    android:id="@+id/profile_EDT_activityDate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/flow_gap_small"
                    android:background="@drawable/bg_flow_input"
                    android:hint="Date"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />

                <EditText
                    android:id="@+id/profile_EDT_activityTime"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/flow_gap_small"
                    android:background="@drawable/bg_flow_input"
                    android:hint="Time"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />

                <EditText
                    android:id="@+id/profile_EDT_activityPrice"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/flow_gap_small"
                    android:background="@drawable/bg_flow_input"
                    android:hint="Price"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />

                <EditText
                    android:id="@+id/profile_EDT_activityLevel"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/flow_gap_small"
                    android:background="@drawable/bg_flow_input"
                    android:hint="Level"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />

                <EditText
                    android:id="@+id/profile_EDT_activityDescription"
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    android:layout_marginTop="@dimen/flow_gap_small"
                    android:background="@drawable/bg_flow_input"
                    android:gravity="top"
                    android:hint="Activity description"
                    android:inputType="textMultiLine"
                    android:paddingTop="12dp"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/profile_LAY_collaborationFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/flow_gap_medium"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/profile_EDT_collaborationLookingFor"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_flow_input"
                    android:hint="Looking for"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />

                <EditText
                    android:id="@+id/profile_EDT_collaborationStyle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/flow_gap_small"
                    android:background="@drawable/bg_flow_input"
                    android:hint="Style"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />

                <AutoCompleteTextView
                    android:id="@+id/profile_EDT_collaborationLocation"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/flow_gap_small"
                    android:background="@drawable/bg_flow_input"
                    android:hint="Location"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />

                <EditText
                    android:id="@+id/profile_EDT_collaborationDate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/flow_gap_small"
                    android:background="@drawable/bg_flow_input"
                    android:hint="Date / deadline"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />

                <AutoCompleteTextView
                    android:id="@+id/profile_EDT_collaborationPaid"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/flow_gap_small"
                    android:background="@drawable/bg_flow_input"
                    android:hint="Paid or unpaid"
                    android:inputType="none"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />

                <EditText
                    android:id="@+id/profile_EDT_collaborationDescription"
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    android:layout_marginTop="@dimen/flow_gap_small"
                    android:background="@drawable/bg_flow_input"
                    android:gravity="top"
                    android:hint="Collaboration description"
                    android:inputType="textMultiLine"
                    android:paddingTop="12dp"
                    android:textColor="@color/flow_ink"
                    android:textColorHint="@color/flow_text_muted" />
            </LinearLayout>

            <Button
                android:id="@+id/profile_BTN_createPost"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/flow_touch_size"
                android:layout_marginTop="@dimen/flow_gap_medium"
                android:background="@drawable/bg_flow_button_primary"
                android:minWidth="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/profile_publish"
                android:textAllCaps="false"
                android:textColor="@color/flow_surface"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_card" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Posts" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:id="@+id/profile_LBL_postsEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="No posts yet." android:textColor="@color/text_muted" android:textSize="14sp" />
            <LinearLayout android:id="@+id/profile_LAY_posts" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
