<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/flow_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="16dp"
        android:paddingTop="14dp"
        android:paddingRight="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/detail_IMG_header"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:background="@drawable/bg_media_gradient"
            android:gravity="center"
            android:textColor="@color/flow_ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail_LBL_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/flow_ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail_LBL_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/flow_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/detail_LBL_schedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_flow_card"
            android:padding="14dp"
            android:textColor="@color/flow_text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/detail_LAY_external_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_flow_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Directions, call, website &amp; map"
                android:textColor="@color/flow_text_secondary"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/detail_BTN_more_actions"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_flow_icon_button"
                android:contentDescription="@string/detail_more_actions"
                android:scaleType="center"
                android:src="@drawable/ic_more_horizontal_24" />
        </LinearLayout>

        <TextView
            android:id="@+id/detail_LBL_attribution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/detail_google_attribution"
            android:textColor="@color/flow_text_muted"
            android:textSize="11sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/detail_BTN_claim_studio"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_flow_button_primary"
            android:text="Claim Studio"
            android:textAllCaps="false"
            android:textColor="@color/flow_surface"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/detail_BTN_save"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_flow_button_secondary"
            android:text="Save"
            android:textAllCaps="false"
            android:textColor="@color/flow_brand" />

        <Button
            android:id="@+id/detail_BTN_follow"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_flow_button_secondary"
            android:text="Follow Studio"
            android:textAllCaps="false"
            android:textColor="@color/flow_brand" />

        <Button
            android:id="@+id/detail_BTN_back"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_flow_button_secondary"
            android:text="Back"
            android:textAllCaps="false"
            android:textColor="@color/flow_brand" />

    </LinearLayout>
</ScrollView>
