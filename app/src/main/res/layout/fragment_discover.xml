<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_discover_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/discover_screen_padding"
    android:paddingTop="18dp"
    android:paddingEnd="@dimen/discover_screen_padding">

    <TextView
        android:id="@+id/discover_LBL_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Discover"
        android:textColor="@color/discover_ink"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/discover_LBL_explanation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:text="Find classes, events, studios, and dancers that fit your flow."
        android:textColor="@color/discover_text_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/discover_LAY_search_box"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="@dimen/discover_section_gap"
        android:background="@drawable/bg_discover_input"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_discover_24"
            android:tint="@color/discover_text_muted" />

        <TextView
            android:id="@+id/discover_EDT_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="Search styles, studios, teachers, events..."
            android:textColor="@color/discover_text_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/discover_PRG_searching"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/discover_purple"
        android:visibility="gone" />

    <TextView
        android:id="@+id/discover_LBL_loading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_horizontal"
        android:text="Finding your flow..."
        android:textColor="@color/discover_text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/discover_SWIPE_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/discover_RCY_sections"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="16dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
