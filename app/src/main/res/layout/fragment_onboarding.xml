<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/flow_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <Button
            android:id="@+id/onboarding_BTN_back"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_flow_button_secondary"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Back"
            android:textAllCaps="false"
            android:textColor="@color/flow_brand"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/onboarding_LAY_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_register_hero"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="32dp"
            android:paddingEnd="28dp"
            android:paddingBottom="44dp">

            <TextView
                android:id="@+id/onboarding_LBL_eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="THE FLOW"
                android:textColor="@color/flow_lilac_soft"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/onboarding_LBL_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Let's build your dance profile"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/onboarding_LBL_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="Tell us how you move, and THE FLOW will personalize your feed and discovery from day one."
                android:textColor="@color/flow_lilac_soft"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="-26dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_flow_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:text="DANCE STYLES"
                android:textColor="@color/flow_text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="4dp"
                android:text="Pick everything you dance or want to explore."
                android:textColor="@color/flow_text_secondary"
                android:textSize="12sp" />

            <CheckBox android:id="@+id/onboarding_CHK_hiphop" android:layout_width="match_parent" android:layout_height="@dimen/flow_touch_size" android:text="Hip Hop" android:textColor="@color/flow_text_secondary" android:checked="true" />
            <CheckBox android:id="@+id/onboarding_CHK_heels" android:layout_width="match_parent" android:layout_height="@dimen/flow_touch_size" android:text="Heels" android:textColor="@color/flow_text_secondary" android:checked="true" />
            <CheckBox android:id="@+id/onboarding_CHK_salsa" android:layout_width="match_parent" android:layout_height="@dimen/flow_touch_size" android:text="Salsa" android:textColor="@color/flow_text_secondary" />
            <CheckBox android:id="@+id/onboarding_CHK_contemporary" android:layout_width="match_parent" android:layout_height="@dimen/flow_touch_size" android:text="Contemporary" android:textColor="@color/flow_text_secondary" />
            <CheckBox android:id="@+id/onboarding_CHK_afro" android:layout_width="match_parent" android:layout_height="@dimen/flow_touch_size" android:text="Afro" android:textColor="@color/flow_text_secondary" />
            <CheckBox android:id="@+id/onboarding_CHK_ballet" android:layout_width="match_parent" android:layout_height="@dimen/flow_touch_size" android:text="Ballet" android:textColor="@color/flow_text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.04"
                android:text="YOUR LEVEL"
                android:textColor="@color/flow_text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/onboarding_RADIO_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <RadioButton android:id="@+id/onboarding_RDB_beginner" android:layout_width="match_parent" android:layout_height="@dimen/flow_touch_size" android:text="Beginner" android:textColor="@color/flow_text_secondary" />
                <RadioButton android:id="@+id/onboarding_RDB_intermediate" android:layout_width="match_parent" android:layout_height="@dimen/flow_touch_size" android:text="Intermediate" android:textColor="@color/flow_text_secondary" android:checked="true" />
                <RadioButton android:id="@+id/onboarding_RDB_advanced" android:layout_width="match_parent" android:layout_height="@dimen/flow_touch_size" android:text="Advanced" android:textColor="@color/flow_text_secondary" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.04"
                android:text="LOCATION"
                android:textColor="@color/flow_text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <AutoCompleteTextView
                android:id="@+id/onboarding_EDT_location"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_flow_input"
                android:focusable="true"
                android:hint="City"
                android:inputType="none"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Tel Aviv"
                android:textColor="@color/flow_ink"
                android:textColorHint="@color/flow_text_muted" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.04"
                android:text="OPTIONAL PREFERENCES"
                android:textColor="@color/flow_text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/onboarding_EDT_preferredStudios"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_flow_input"
                android:hint="Preferred studios, comma separated"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/flow_ink"
                android:textColorHint="@color/flow_text_muted" />

            <EditText
                android:id="@+id/onboarding_EDT_preferredTeachers"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_flow_input"
                android:hint="Preferred teachers, comma separated"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/flow_ink"
                android:textColorHint="@color/flow_text_muted" />

            <EditText
                android:id="@+id/onboarding_EDT_preferredDancers"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_flow_input"
                android:hint="Preferred dancers, comma separated"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/flow_ink"
                android:textColorHint="@color/flow_text_muted" />

            <Button
                android:id="@+id/onboarding_BTN_continue"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_flow_button_primary"
                android:text="Start Discovering"
                android:textAllCaps="false"
                android:textColor="@color/flow_surface"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
