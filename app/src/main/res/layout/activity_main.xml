<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:padding="18dp">

    <FrameLayout
        android:id="@+id/main_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/main_LAY_topActions"
        android:layout_above="@+id/main_LAY_bottomNav" />

    <LinearLayout
        android:id="@+id/main_LAY_topActions"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/main_BOX_notifications"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_icon_button_compact"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/main_nav_notifications"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_notifications_24"
                android:tint="@color/text_primary" />

            <TextView
                android:id="@+id/main_badge_notifications"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_gravity="top|right"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:minWidth="18dp"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/main_BOX_messages"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_icon_button_compact"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/main_nav_messages"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_chat_24"
                android:tint="@color/text_primary" />

            <TextView
                android:id="@+id/main_badge_messages"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_gravity="top|right"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:minWidth="18dp"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/main_LAY_bottomNav"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_bottom_nav"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="10dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/main_nav_home"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Home"
                android:textColor="@color/neon_pink"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/main_nav_discover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Discover"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/main_nav_profile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Profile"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </FrameLayout>

    </LinearLayout>
</RelativeLayout>
