<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/flow_lilac_soft" />
            <stroke android:width="1dp" android:color="@color/flow_lilac" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/flow_surface_alt" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/flow_surface" />
            <stroke android:width="1dp" android:color="@color/flow_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
