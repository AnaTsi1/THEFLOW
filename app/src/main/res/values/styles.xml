<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Flow" />

    <style name="Flow.Screen">
        <item name="android:background">@drawable/bg_flow_screen</item>
        <item name="android:paddingStart">@dimen/flow_screen_padding</item>
        <item name="android:paddingEnd">@dimen/flow_screen_padding</item>
    </style>

    <style name="Flow.Text" />

    <style name="Flow.Text.Title">
        <item name="android:textColor">@color/flow_ink</item>
        <item name="android:textSize">@dimen/flow_title_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Flow.Text.SectionTitle">
        <item name="android:textColor">@color/flow_ink</item>
        <item name="android:textSize">@dimen/flow_section_title_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Flow.Text.Body">
        <item name="android:textColor">@color/flow_text_secondary</item>
        <item name="android:textSize">@dimen/flow_body_text</item>
    </style>

    <style name="Flow.Text.Meta">
        <item name="android:textColor">@color/flow_text_muted</item>
        <item name="android:textSize">@dimen/flow_meta_text</item>
    </style>

    <style name="Flow.Card">
        <item name="android:background">@drawable/bg_flow_card</item>
        <item name="android:padding">@dimen/flow_card_padding</item>
    </style>

    <style name="Flow.Button" />

    <style name="Flow.Button.Primary">
        <item name="android:layout_height">@dimen/flow_touch_size</item>
        <item name="android:background">@drawable/bg_flow_button_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Flow.Button.Secondary">
        <item name="android:layout_height">@dimen/flow_touch_size</item>
        <item name="android:background">@drawable/bg_flow_button_secondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/flow_brand</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Flow.Button.Ghost">
        <item name="android:layout_height">@dimen/flow_touch_size</item>
        <item name="android:background">@drawable/bg_flow_button_ghost</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/flow_text_secondary</item>
    </style>

    <style name="Flow.Button.Icon">
        <item name="android:layout_width">@dimen/flow_touch_size</item>
        <item name="android:layout_height">@dimen/flow_touch_size</item>
        <item name="android:background">@drawable/bg_flow_drawer_row</item>
        <item name="android:padding">10dp</item>
        <item name="android:tint">@color/flow_brand</item>
    </style>

    <style name="Flow.Input">
        <item name="android:layout_height">54dp</item>
        <item name="android:background">@drawable/bg_flow_input</item>
        <item name="android:textColor">@color/flow_ink</item>
        <item name="android:textColorHint">@color/flow_text_muted</item>
        <item name="android:textSize">@dimen/flow_body_text</item>
    </style>

    <style name="Flow.Chip">
        <item name="android:background">@drawable/bg_flow_chip</item>
        <item name="android:textColor">@color/flow_brand</item>
        <item name="android:textSize">@dimen/flow_meta_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Flow.Drawer" />

    <style name="Flow.Drawer.Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_flow_icon_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="Flow.Drawer.Icon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:tint">@color/flow_brand</item>
    </style>

    <style name="Flow.Drawer.Label">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/flow_ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
