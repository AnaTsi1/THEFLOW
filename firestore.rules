rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function studioDoc(studioId) {
      return /databases/$(database)/documents/studios/$(studioId);
    }

    function isAdmin() {
      return signedIn()
        && exists(userDoc(request.auth.uid))
        && get(userDoc(request.auth.uid)).data.role in ['admin', 'ADMIN', 'Admin'];
    }

    // Studio permissions are additive and derived entirely from managedStudioIds - never from
    // a role value. A user can be a dancer AND manage any number of studios at once.
    function managesAnyStudio() {
      return signedIn()
        && exists(userDoc(request.auth.uid))
        && 'managedStudioIds' in get(userDoc(request.auth.uid)).data
        && get(userDoc(request.auth.uid)).data.managedStudioIds.size() > 0;
    }

    function managesStudio(studioId) {
      return signedIn()
        && studioId is string && studioId != ''
        && exists(userDoc(request.auth.uid))
        && 'managedStudioIds' in get(userDoc(request.auth.uid)).data
        && studioId in get(userDoc(request.auth.uid)).data.managedStudioIds;
    }

    // Cross-document manager check read directly off the studio doc (used when the caller's own
    // user doc isn't what's being written, e.g. posts/jobs/conversations belonging to a studio).
    function isManagerOfStudioDoc(studioId) {
      return signedIn()
        && studioId is string && studioId != ''
        && exists(studioDoc(studioId))
        && (
          get(studioDoc(studioId)).data.ownerUid == request.auth.uid
          || request.auth.uid in get(studioDoc(studioId)).data.managerUids
        );
    }

    function isApprovedProfessional() {
      return signedIn()
        && exists(userDoc(request.auth.uid))
        && (
          get(userDoc(request.auth.uid)).data.role in ['admin', 'ADMIN', 'Admin']
          || get(userDoc(request.auth.uid)).data.verifiedTeacher == true
          || get(userDoc(request.auth.uid)).data.verifiedChoreographer == true
          || managesAnyStudio()
        );
    }

    // Collaboration posts ("looking for a dancer/choreographer/project partner") are a
    // choreographer-facing tool - narrower than isApprovedProfessional(), which also admits
    // teachers and studio managers.
    function isVerifiedChoreographerOrAdmin() {
      return signedIn()
        && exists(userDoc(request.auth.uid))
        && (
          get(userDoc(request.auth.uid)).data.role in ['admin', 'ADMIN', 'Admin']
          || get(userDoc(request.auth.uid)).data.verifiedChoreographer == true
        );
    }

    function unchanged(field) {
      return !(field in request.resource.data)
        || (field in resource.data && request.resource.data[field] == resource.data[field]);
    }

    function keepsUserAdminFieldsSafe() {
      return unchanged('role')
        && unchanged('verifiedTeacher')
        && unchanged('verifiedChoreographer')
        && unchanged('professionalBadges')
        && unchanged('managedStudioIds');
    }

    // Self-registration only ever produces a plain dancer account with no permissions. Every
    // professional/studio permission is granted later by an admin, never chosen at signup.
    function createsOwnUser(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['dancer', 'DANCER']
        && (!('managedStudioIds' in request.resource.data) || request.resource.data.managedStudioIds.size() == 0)
        && (!('verifiedTeacher' in request.resource.data) || request.resource.data.verifiedTeacher == false)
        && (!('verifiedChoreographer' in request.resource.data) || request.resource.data.verifiedChoreographer == false);
    }

    function isPostAuthor() {
      return signedIn() && resource.data.authorId == request.auth.uid;
    }

    // A post authored on behalf of a studio business account (Phase 3 content attribution).
    // authorId always stays the acting human's uid regardless - only the entity fields change.
    function postIsStudioAuthored() {
      return 'authorEntityType' in resource.data && resource.data.authorEntityType == 'studio';
    }

    function postAuthorEntityId() {
      return postIsStudioAuthored() ? resource.data.authorEntityId : '';
    }

    // Any current manager of the studio a post is attributed to may manage it - not just the
    // one manager who happened to write it - mirroring the existing canManageJob precedent.
    function canManagePost() {
      return isPostAuthor() || (postIsStudioAuthored() && managesStudio(postAuthorEntityId()));
    }

    function createsOwnPost() {
      return signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.visibility in ['public', 'followers', 'private']
        && (
          !('postType' in request.resource.data)
          || request.resource.data.postType != 'collaboration'
          || isVerifiedChoreographerOrAdmin()
        )
        && (
          !('authorEntityType' in request.resource.data)
          || request.resource.data.authorEntityType == 'user'
          || (
            request.resource.data.authorEntityType == 'studio'
            && managesStudio(request.resource.data.authorEntityId)
          )
        );
    }

    function isPublicPost() {
      return !('visibility' in resource.data) || resource.data.visibility == 'public';
    }

    function postPath(postId) {
      return /databases/$(database)/documents/posts/$(postId);
    }

    function canReadPost(postId) {
      return signedIn()
        && exists(postPath(postId))
        && (
          !('visibility' in get(postPath(postId)).data)
          || get(postPath(postId)).data.visibility == 'public'
          || get(postPath(postId)).data.authorId == request.auth.uid
          || isAdmin()
          || (
            'authorEntityType' in get(postPath(postId)).data
            && get(postPath(postId)).data.authorEntityType == 'studio'
            && managesStudio(get(postPath(postId)).data.authorEntityId)
          )
        );
    }

    function previousLikesCount() {
      return ('likesCount' in resource.data) ? resource.data.likesCount : 0;
    }

    function previousCommentsCount() {
      return ('commentsCount' in resource.data) ? resource.data.commentsCount : 0;
    }

    function previousRegistrationsCount() {
      return ('registrationsCount' in resource.data) ? resource.data.registrationsCount : 0;
    }

    function previousWaitlistCount() {
      return ('waitlistCount' in resource.data) ? resource.data.waitlistCount : 0;
    }

    function isSafePostEngagementUpdate(fields) {
      return signedIn()
        && isPublicPost()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function isSafeLikeCountUpdate() {
      return isSafePostEngagementUpdate(['likesCount', 'updatedAt'])
        && (
          request.resource.data.likesCount == previousLikesCount() + 1
          || request.resource.data.likesCount == previousLikesCount() - 1
        )
        && request.resource.data.likesCount >= 0;
    }

    function isSafeCommentCountUpdate() {
      return isSafePostEngagementUpdate(['commentsCount', 'updatedAt'])
        && (
          request.resource.data.commentsCount == previousCommentsCount() + 1
          || request.resource.data.commentsCount == previousCommentsCount() - 1
        )
        && request.resource.data.commentsCount >= 0;
    }

    function isSafeRegistrationCountUpdate() {
      return signedIn()
        && isPublicPost()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['registrationsCount', 'waitlistCount', 'updatedAt'])
        && request.resource.data.registrationsCount >= 0
        && request.resource.data.waitlistCount >= 0
        && (
          request.resource.data.registrationsCount == previousRegistrationsCount()
          || request.resource.data.registrationsCount == previousRegistrationsCount() + 1
          || request.resource.data.registrationsCount == previousRegistrationsCount() - 1
        )
        && (
          request.resource.data.waitlistCount == previousWaitlistCount()
          || request.resource.data.waitlistCount == previousWaitlistCount() + 1
          || request.resource.data.waitlistCount == previousWaitlistCount() - 1
        );
    }

    function isStudioOwnerOrManager() {
      return signedIn()
        && (
          resource.data.ownerUid == request.auth.uid
          || request.auth.uid in resource.data.managerUids
        );
    }

    // Guards the fields only an admin may ever change on a studio: ownership, manager list,
    // verification, and lifecycle status. Fixes a prior hole where any current manager could
    // silently self-verify a studio or rewrite its manager list.
    function keepsStudioAdminFieldsSafe() {
      return unchanged('ownerUid')
        && unchanged('managerUids')
        && unchanged('verified')
        && unchanged('status')
        && unchanged('googlePlaceId')
        && unchanged('externalSource')
        && unchanged('claimStatus')
        && unchanged('claimUpdatedAt');
    }

    function isVisibleStudio() {
      return resource.data.verified == true || resource.data.status == 'APPROVED';
    }

    function previousStudioFollowersCount() {
      return ('followersCount' in resource.data) ? resource.data.followersCount : 0;
    }

    // Lets any signed-in user toggle their own follow of a studio without needing manager
    // access, mirroring isSafeLikeCountUpdate() on posts.
    function isSafeStudioFollowerCountUpdate() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount'])
        && (
          request.resource.data.followersCount == previousStudioFollowersCount() + 1
          || request.resource.data.followersCount == previousStudioFollowersCount() - 1
        )
        && request.resource.data.followersCount >= 0;
    }

    function createsStudioRequest() {
      return signedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.type in ['CREATE', 'CLAIM']
        && (
          (
            request.resource.data.type == 'CREATE'
            && request.resource.data.draftDisplayName is string
            && request.resource.data.draftDisplayName.size() > 0
            && (!('studioId' in request.resource.data) || request.resource.data.studioId == '')
          )
          || (
            request.resource.data.type == 'CLAIM'
            && request.resource.data.studioId is string
            && request.resource.data.studioId != ''
          )
        )
        && (!('resultStudioId' in request.resource.data) || request.resource.data.resultStudioId == '');
    }

    function conversationPath(conversationId) {
      return /databases/$(database)/documents/conversations/$(conversationId);
    }

    // A conversation's human side (participantIds) or, for a studio inbox thread, any current
    // manager of that studio - so a newly added manager immediately sees the shared history.
    function canAccessConversation(conversationId) {
      return signedIn()
        && exists(conversationPath(conversationId))
        && (
          request.auth.uid in get(conversationPath(conversationId)).data.participantIds
          || (
            'studioId' in get(conversationPath(conversationId)).data
            && get(conversationPath(conversationId)).data.studioId != ''
            && isManagerOfStudioDoc(get(conversationPath(conversationId)).data.studioId)
          )
        );
    }

    function createsUserConversation(conversationId) {
      return signedIn()
        && request.resource.data.conversationId == conversationId
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && (!('studioId' in request.resource.data) || request.resource.data.studioId == '');
    }

    // Validates the "{customerUid}__studio_{studioId}" id scheme and that either the customer or
    // a current manager of the studio is the one opening it - studio<->studio isn't supported.
    function createsStudioConversation(conversationId) {
      return signedIn()
        && request.resource.data.conversationId == conversationId
        && 'studioId' in request.resource.data
        && request.resource.data.studioId is string
        && request.resource.data.studioId != ''
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 1
        && conversationId == request.resource.data.participantIds[0] + '__studio_' + request.resource.data.studioId
        && (
          request.auth.uid == request.resource.data.participantIds[0]
          || isManagerOfStudioDoc(request.resource.data.studioId)
        );
    }

    function isAllowedNotificationType(type) {
      return type in [
        'like',
        'comment',
        'follow',
        'private_message',
        'professional_approved',
        'professional_rejected',
        'event_updated',
        'event_recommended',
        'job_recommended',
        'job_application_received',
        'job_application_updated',
        'studio_follow',
        'studio_message',
        'event_registration',
        'studio_post_comment',
        'studio_post_like',
        'permission_granted',
        'permission_revoked',
        'studio_request_approved',
        'studio_request_rejected'
      ];
    }

    // Jobs are business-account-only: a poster must be an admin or a manager of the studio the
    // job belongs to. There is no personal "post as yourself if verified choreographer" path.
    function canPublishJobForStudio(studioId) {
      return signedIn()
        && studioId is string
        && studioId != ''
        && (
          isAdmin()
          || (
            exists(userDoc(request.auth.uid))
            && 'managedStudioIds' in get(userDoc(request.auth.uid)).data
            && studioId in get(userDoc(request.auth.uid)).data.managedStudioIds
          )
        );
    }

    function jobPath(jobId) {
      return /databases/$(database)/documents/jobs/$(jobId);
    }

    function canManageJob(jobId) {
      return signedIn()
        && exists(jobPath(jobId))
        && (
          isAdmin()
          || get(jobPath(jobId)).data.creatorId == request.auth.uid
          || (
            get(jobPath(jobId)).data.studioId is string
            && get(jobPath(jobId)).data.studioId != ''
            && exists(userDoc(request.auth.uid))
            && 'managedStudioIds' in get(userDoc(request.auth.uid)).data
            && get(jobPath(jobId)).data.studioId in get(userDoc(request.auth.uid)).data.managedStudioIds
          )
        );
    }

    function createsOwnJob(jobId) {
      return signedIn()
        && request.resource.data.jobId == jobId
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.status in ['active', 'closed', 'filled']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.employerName is string
        && request.resource.data.employerName.size() > 0
        && request.resource.data.city is string
        && request.resource.data.city.size() > 0
        && request.resource.data.studioId is string
        && request.resource.data.studioId != ''
        && canPublishJobForStudio(request.resource.data.studioId);
    }

    function keepsJobOwnershipSafe() {
      return request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.studioId == resource.data.studioId;
    }

    function applicationIdFor(jobId, applicantId) {
      return jobId + '_' + applicantId;
    }

    function createsOwnJobApplication(applicationId) {
      return signedIn()
        && request.resource.data.applicationId == applicationId
        && request.resource.data.applicantId == request.auth.uid
        && applicationId == applicationIdFor(request.resource.data.jobId, request.auth.uid)
        && exists(jobPath(request.resource.data.jobId))
        && get(jobPath(request.resource.data.jobId)).data.status == 'active'
        && get(jobPath(request.resource.data.jobId)).data.creatorId != request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.introduction is string
        && request.resource.data.introduction.size() > 0;
    }

    function applicantKeepsSubmittedFieldsSafe() {
      return request.resource.data.applicationId == resource.data.applicationId
        && request.resource.data.jobId == resource.data.jobId
        && request.resource.data.applicantId == resource.data.applicantId
        && request.resource.data.applicantName == resource.data.applicantName
        && request.resource.data.introduction == resource.data.introduction
        && request.resource.data.experience == resource.data.experience
        && request.resource.data.portfolioUrl == resource.data.portfolioUrl
        && request.resource.data.status == 'withdrawn';
    }

    function employerStatusOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['submitted', 'viewed', 'contacted', 'accepted', 'rejected', 'withdrawn'];
    }

    match /users/{uid} {
      allow get: if signedIn();
      allow list: if signedIn();
      allow create: if createsOwnUser(uid) || isAdmin();
      allow update: if isAdmin() || (isOwner(uid) && keepsUserAdminFieldsSafe());
      allow delete: if isAdmin() || isOwner(uid);

      match /recommendationProfile/{profileId} {
        allow read, write: if isOwner(uid) || isAdmin();

        match /signalDedupe/{dedupeId} {
          allow read, create, update: if isOwner(uid) || isAdmin();
          allow delete: if isAdmin();
        }
      }

      match /recommendationImpressions/{impressionId} {
        allow read, create, update: if isOwner(uid) || isAdmin();
        allow delete: if isAdmin();
      }

      match /followingDancers/{followId} {
        allow get: if isOwner(uid) || isOwner(followId) || isAdmin();
        allow list: if isOwner(uid) || isAdmin();
        allow create, update, delete: if isOwner(uid) || isAdmin();
      }

      match /followingTeachers/{followId} {
        allow get: if isOwner(uid) || isOwner(followId) || isAdmin();
        allow list: if isOwner(uid) || isAdmin();
        allow create, update, delete: if isOwner(uid) || isAdmin();
      }

      match /followingStudios/{followId} {
        allow get: if isOwner(uid) || isOwner(followId) || isAdmin();
        allow list: if isOwner(uid) || isAdmin();
        allow create, update, delete: if isOwner(uid) || isAdmin();
      }

      match /followers/{followerId} {
        allow read: if signedIn();
        allow create, update, delete: if isOwner(uid) || isOwner(followerId) || isAdmin();
      }

      match /notifications/{notificationId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create: if signedIn()
          && request.resource.data.actorId == request.auth.uid
          && request.auth.uid != uid
          && request.resource.data.type is string
          && isAllowedNotificationType(request.resource.data.type)
          && request.resource.data.title is string
          && request.resource.data.message is string
          && request.resource.data.isRead == false;
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
          && request.resource.data.isRead == true;
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /savedPosts/{savedId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /savedItems/{savedId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /savedJobs/{savedId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /favoritePosts/{favoriteId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /favorites/{favoriteId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /likedPosts/{likedId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    match /posts/{postId} {
      allow get, list: if isPublicPost()
        || isPostAuthor()
        || isAdmin()
        || (postIsStudioAuthored() && managesStudio(postAuthorEntityId()));
      allow create: if createsOwnPost();
      allow update: if isAdmin()
        || canManagePost()
        || isSafeLikeCountUpdate()
        || isSafeCommentCountUpdate()
        || isSafeRegistrationCountUpdate();
      allow delete: if canManagePost() || isAdmin();

      match /likes/{uid} {
        allow read: if canReadPost(postId);
        allow create, update: if (isOwner(uid) || isAdmin())
          && request.resource.data.userId == uid
          && request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /comments/{commentId} {
        allow read: if canReadPost(postId);
        allow create: if canReadPost(postId)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.postId == postId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0;
        allow update, delete: if isAdmin()
          || (signedIn() && resource.data.authorId == request.auth.uid);

        match /likes/{uid} {
          allow read: if canReadPost(postId);
          allow create, update: if (isOwner(uid) || isAdmin())
            && request.resource.data.userId == uid
            && request.resource.data.userId == request.auth.uid;
          allow delete: if isOwner(uid) || isAdmin();
        }

        match /replies/{replyId} {
          allow read: if canReadPost(postId);
          allow create: if canReadPost(postId)
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.postId == postId
            && request.resource.data.commentId == commentId
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0;
          allow update, delete: if isAdmin()
            || (signedIn() && resource.data.authorId == request.auth.uid);
        }
      }

      match /saves/{uid} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /registrations/{uid} {
        allow read: if signedIn();
        allow write: if isOwner(uid) || isAdmin();
      }
    }

    match /activities/{activityId} {
      allow get, list: if signedIn()
        && (
          resource.data.status == 'published'
          || resource.data.creatorUid == request.auth.uid
          || isAdmin()
        );
      allow create: if isApprovedProfessional()
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.title is string
        && request.resource.data.activityType in ['class', 'workshop', 'event'];
      allow update: if isAdmin()
        || (
          isApprovedProfessional()
          && resource.data.creatorUid == request.auth.uid
          && request.resource.data.creatorUid == resource.data.creatorUid
          && request.resource.data.status in ['draft', 'published', 'cancelled', 'past']
        );
      allow delete: if isAdmin()
        || (
          isApprovedProfessional()
          && resource.data.creatorUid == request.auth.uid
        );
    }

    match /jobs/{jobId} {
      allow get, list: if signedIn();
      allow create: if createsOwnJob(jobId);
      allow update: if canManageJob(jobId)
        && keepsJobOwnershipSafe()
        && request.resource.data.status in ['active', 'closed', 'filled'];
      allow delete: if canManageJob(jobId);
    }

    match /jobApplications/{applicationId} {
      allow get, list: if signedIn()
        && (
          resource.data.applicantId == request.auth.uid
          || canManageJob(resource.data.jobId)
        );
      allow create: if createsOwnJobApplication(applicationId);
      allow update: if signedIn()
        && (
          (
            resource.data.applicantId == request.auth.uid
            && applicantKeepsSubmittedFieldsSafe()
          )
          || (
            canManageJob(resource.data.jobId)
            && employerStatusOnlyUpdate()
          )
        );
      allow delete: if false;
    }

    match /studios/{studioId} {
      allow get: if signedIn() && (isVisibleStudio() || isStudioOwnerOrManager() || isAdmin());
      allow list: if signedIn();
      // Studios are never self-service created - they only ever come from an admin approving a
      // studioRequests document (create or claim).
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (
          isStudioOwnerOrManager()
          && keepsStudioAdminFieldsSafe()
        )
        || (
          // Any signed-in user may flag an unowned, visible studio as claim-pending - this is
          // the one write StudioRequestRepository.submitClaimRequest performs before an admin
          // reviews the resulting request.
          signedIn()
          && isVisibleStudio()
          && (!('ownerUid' in resource.data) || resource.data.ownerUid == '')
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['claimStatus', 'claimUpdatedAt'])
          && request.resource.data.claimStatus == 'PENDING'
        )
        || isSafeStudioFollowerCountUpdate();
      allow delete: if isAdmin();

      match /followers/{uid} {
        allow read: if signedIn();
        allow write: if isOwner(uid) || isAdmin();
      }

      match /favorites/{uid} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /savedBy/{uid} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      // A studio's shared inbox - every current manager sees and clears the same notifications.
      match /notifications/{notificationId} {
        allow get, list: if isManagerOfStudioDoc(studioId) || isAdmin();
        allow create: if signedIn()
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.type is string
          && isAllowedNotificationType(request.resource.data.type)
          && request.resource.data.title is string
          && request.resource.data.message is string
          && request.resource.data.isRead == false;
        allow update: if (isManagerOfStudioDoc(studioId) || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readByUid'])
          && request.resource.data.isRead == true;
        allow delete: if isManagerOfStudioDoc(studioId) || isAdmin();
      }
    }

    // Legacy collection, kept read-only so any in-flight claims can still drain through the
    // admin queue. All new requests go to /studioRequests instead.
    match /studioClaims/{claimId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.requesterUid == request.auth.uid)
        || (signedIn() && resource.data.status == 'PENDING');
      allow create: if false;
      allow update: if isAdmin()
        && resource.data.requesterUid != request.auth.uid;
      allow delete: if isAdmin();
    }

    match /studioRequests/{requestId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.requesterUid == request.auth.uid);
      allow create: if createsStudioRequest();
      allow update: if isAdmin()
        && resource.data.requesterUid != request.auth.uid;
      allow delete: if isAdmin();
    }

    match /permissionGrants/{grantId} {
      allow read, write: if isAdmin();
    }

    match /externalStudios/{placeId} {
      allow get, list: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.googlePlaceId == placeId
        && request.resource.data.source == 'google';
      allow delete: if isAdmin();
    }

    match /professionalApplications/{applicationId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.applicantUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.applicationType in ['verified_teacher', 'choreographer'];
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.applicantUid == request.auth.uid
          && request.resource.data.applicantUid == request.auth.uid
          && request.resource.data.status == resource.data.status
        );
      allow delete: if isAdmin();
    }

    match /userActivityEvents/{eventId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.eventType is string
        && request.resource.data.targetType is string;
      allow update, delete: if isAdmin();
    }

    match /contentReports/{reportId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType is string
        && request.resource.data.targetId is string
        && request.resource.data.status == 'open';
      allow update, delete: if isAdmin();
    }

    match /accountDeletionRequests/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'requested';
      allow delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow get, list: if canAccessConversation(conversationId);
      allow create: if createsUserConversation(conversationId) || createsStudioConversation(conversationId);
      allow update: if canAccessConversation(conversationId)
        && request.resource.data.participantIds == resource.data.participantIds
        && (!('studioId' in resource.data) || request.resource.data.studioId == resource.data.studioId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'lastSenderPartyKey', 'unreadCounts', 'updatedAt', 'participantInfo', 'partyKeys']);
      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if canAccessConversation(conversationId);
        allow create: if canAccessConversation(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.type == 'text';
        allow update: if canAccessConversation(conversationId)
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.text == resource.data.text
          && request.resource.data.type == resource.data.type
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
